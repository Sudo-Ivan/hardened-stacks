{
    "name": "hardened-stacks/user-management",
    "description": "User moderation tools for Flarum",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "HardenedStacks\\UserManagement\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "User Management",
            "category": "feature",
            "icon": {
                "name": "fas fa-user-shield",
                "backgroundColor": "#0d47a1",
                "color": "#fff"
            }
        }
    }
}
