{
    "name": "hardened-stacks/altcha",
    "description": "Self-hosted ALTCHA proof-of-work for Flarum",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8",
        "altcha-org/altcha": "^1.3.3"
    },
    "autoload": {
        "psr-4": {
            "HardenedStacks\\Altcha\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "ALTCHA",
            "category": "feature",
            "icon": {
                "name": "fas fa-robot",
                "backgroundColor": "#263238",
                "color": "#fff"
            }
        }
    }
}
